# Maven build output
/target/

# Dependency-reduced POMs generated by the shade plugin (can be regenerated)
dependency-reduced-pom.xml

# Java class files
*.class

# Packaged files
*.jar
*.war
*.ear

# IDEs
# IntelliJ
*.iml
.idea/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

# macOS
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# Android / Dex
*.apk
*.ap_
*.dex
proguard/

# Generated folders
/bin/
/gen/

# Local configuration
local.properties

# Misc
Thumbs.db

# Ignore generated site staging directory (if created)
/target/staging/

# Optional: ignore module created site outputs (these are build artifacts)
**/target/site/

# Keep dependency reduced POMs out of the index (already above)

# Note: do NOT ignore source files, docs, or important CI configs
# If you want .idea excluded from commits entirely, prefer adding it to the global gitignore
