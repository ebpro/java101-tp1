# Maven build outputs (ignore module targets too)
/target/
**/target/

# Ignore staging and aggregated site outputs (local build artifacts)
**/target/staging/
**/target/site/

# Jacoco execution data and reports
**/target/jacoco.exec
**/jacoco.exec
**/target/site/jacoco/**

# Surefire / Failsafe test reports
**/target/surefire-reports/
**/target/failsafe-reports/

# Maven status files produced during compilation
**/target/maven-status/

# Keep dependency reduced POMs out of the index (can be regenerated)
dependency-reduced-pom.xml

# Java class files
*.class

# Packaged files
*.jar
*.war
*.ear

# IDEs
# IntelliJ
*.iml
.idea/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

# macOS
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# Android / Dex
*.apk
*.ap_
*.dex
proguard/

# Generated folders
/bin/
/gen/

# Local configuration
local.properties

# Misc
Thumbs.db

# Ignore generated site staging directory (if created)
/target/staging/

# Optional: ignore module created site outputs (these are build artifacts)
**/target/site/

# Keep dependency reduced POMs out of the index (already above)

# Note: do NOT ignore source files, docs, or important CI configs
# If you want .idea excluded from commits entirely, prefer adding it to the global gitignore
