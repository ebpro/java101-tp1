<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration>

<configuration>
  <!-- Default LOG_LEVEL can be overridden by -DLOG_LEVEL=... (fallback to DEBUG) -->
  <property name="LOG_LEVEL" value="${LOG_LEVEL:-DEBUG}"/>

  <!-- Console appender with a simple pattern. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Ensure tp3 package respects LOG_LEVEL and can show DEBUG when requested -->
  <logger name="fr.univtln.bruno.samples.java101.tp3" level="${LOG_LEVEL}" />

  <root level="${LOG_LEVEL}">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
